# ---------------------------------------------------------------------------
# BdayHero environment. `cp .env.example .env` gives a working local setup
# together with `docker compose -f docker-compose.dev.yml up -d` (Postgres + MailDev).
# In production inject these via Infisical (docs/infisical.md) or your platform.
# Variables prefixed PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Public URL of the site. Required in production (CSRF check for form actions).
ORIGIN="http://localhost:5173"
# Better Auth base URL (defaults to ORIGIN) and secret (>= 32 random chars, e.g. `openssl rand -base64 32`)
BETTER_AUTH_URL="http://localhost:5173"
BETTER_AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789"

# Postgres from docker-compose.dev.yml. Docker-free alternative: DATABASE_URL="pglite://./.pglite"
DATABASE_URL="postgres://bdayhero:bdayhero@localhost:5432/bdayhero"
# Apply drizzle/ migrations when the container starts (production image)
MIGRATE_ON_START="true"

# Site
PROJ_TITLE="KidsBday"
# Show only the landing page (registration not open yet)
PUBLIC_HERO_ONLY="false"
PUBLIC_MAX_COMPANIONS_PER_GUEST="1"

# Mail (magic links). EMAIL_TRANSPORT: smtp | json (log to stdout) | file (write to EMAIL_FILE_DIR)
# Dev default: MailDev from docker-compose.dev.yml, inbox at http://localhost:1080
EMAIL_TRANSPORT="smtp"
EMAIL_HOST="localhost"
EMAIL_PORT="1025"
EMAIL_SECURE="false"
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_FROM="noreply@bday.localhost"

# OAuth providers (a provider is enabled when its client id is set).
# Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/<github|google|discord>
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Server (adapter-node, production only)
PORT="3000"
BODY_SIZE_LIMIT="512K"
