# ---------------------------------------------------------------------------
# BdayHero environment. Copy to .env for local development.
# In production inject these via Infisical (docs/infisical.md) or your platform.
# Variables prefixed PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Public URL of the site. Required in production (CSRF check for form actions).
ORIGIN="http://localhost:5173"
# Better Auth base URL (defaults to ORIGIN) and secret (>= 32 random chars, e.g. `openssl rand -base64 32`)
BETTER_AUTH_URL="http://localhost:5173"
BETTER_AUTH_SECRET="change-me-to-a-random-string-with-32-chars"

# Postgres connection string. For Docker-free local dev an embedded PGlite works too:
#   DATABASE_URL="pglite://./.pglite"
DATABASE_URL="postgres://bdayhero:bdayhero@localhost:5432/bdayhero"
# Apply drizzle/ migrations when the container starts
MIGRATE_ON_START="true"

# Site
PROJ_TITLE="KidsBday"
# Show only the landing page (registration not open yet)
PUBLIC_HERO_ONLY="false"
PUBLIC_MAX_COMPANIONS_PER_GUEST="1"

# Mail (magic links). EMAIL_TRANSPORT: smtp | json (log to stdout) | file (write to EMAIL_FILE_DIR)
EMAIL_TRANSPORT="json"
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_HOST_USER="noreply@example.com"
EMAIL_HOST_PASSWORD=""

# OAuth providers (a provider is enabled when its client id is set).
# Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/<github|google|discord>
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Server (adapter-node)
PORT="3000"
BODY_SIZE_LIMIT="512K"
