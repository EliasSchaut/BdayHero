{
	"name": "bdayhero",
	"description": "A 'Save the Date' and sign-up page for my bday",
	"author": "EliasSchaut",
	"license": "MIT",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync && pnpm i18n:compile || echo \"\"",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --silent",
		"check": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:unit": "vitest",
		"test:e2e": "pnpm build && playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.mjs",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node scripts/seed-shifts.mjs",
		"auth:schema": "auth generate --config src/lib/server/auth/index.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"dependencies": {
		"@fontsource-variable/nunito": "^5.3.0",
		"better-auth": "^1.7.25",
		"bits-ui": "^2.21.0",
		"drizzle-orm": "^0.45.4",
		"nodemailer": "^10.5.0",
		"postgres": "^4.1.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.16",
		"@eslint/js": "^10.0.1",
		"@iconify-json/heroicons": "^1.2.3",
		"@inlang/paraglide-js": "^3.2.2",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"@types/nodemailer": "^8.0.2",
		"auth": "^1.7.25",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
